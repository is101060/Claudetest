@{
    var ctrl   = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ClaudetestMVC</title>
    <script>(function(){var t=localStorage.getItem('theme')||'light';document.documentElement.setAttribute('data-theme',t);var s=localStorage.getItem('sidebar');if(s==='collapsed')document.documentElement.classList.add('sidebar-collapsed');})();</script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ClaudetestMVC.styles.css" asp-append-version="true" />
</head>
<body>

    <!-- ── Topbar ───────────────────────────────────────────────── -->
    <header class="topbar">
        <button class="topbar-btn" id="sidebarToggle" aria-label="Menú">&#9776;</button>
        <span class="topbar-brand">ClaudetestMVC</span>

        <div class="topbar-right">
            <button class="theme-toggle" id="themeToggle" title="Cambiar tema" aria-label="Cambiar tema">
                <span class="icon-moon">Oscuro</span>
                <span class="icon-sun">Claro</span>
            </button>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <span class="topbar-user">@User.Identity.Name</span>
                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-light btn-sm">Cerrar sesión</button>
                </form>
            }
        </div>
    </header>

    <!-- ── Cuerpo principal ──────────────────────────────────────── -->
    <div class="app-body">

        <!-- Sidebar -->
        <aside class="sidebar" id="sidebar">
            <nav class="sidebar-nav">

                <div class="sidebar-section-title">Principal</div>
                <ul>
                    <li>
                        <a class="sidebar-link @(ctrl=="Home" && action=="Index" ? "active" : "")"
                           asp-controller="Home" asp-action="Index">Inicio</a>
                    </li>
                    <li>
                        <a class="sidebar-link @(ctrl=="Dashboard" ? "active" : "")"
                           asp-controller="Dashboard" asp-action="Index">Dashboard</a>
                    </li>
                    <li>
                        <a class="sidebar-link @(ctrl=="Reportes" ? "active" : "")"
                           asp-controller="Reportes" asp-action="Index">Reportes</a>
                    </li>
                </ul>

                <div class="sidebar-section-title">Gestión</div>
                <ul>
                    <li>
                        <a class="sidebar-link @(ctrl=="Usuarios" ? "active" : "")"
                           asp-controller="Usuarios" asp-action="Index">Usuarios</a>
                    </li>
                    <li>
                        <a class="sidebar-link @(ctrl=="Catalogos" ? "active" : "")"
                           asp-controller="Catalogos" asp-action="Index">Catálogos</a>
                    </li>
                </ul>

                <div class="sidebar-section-title">Sistema</div>
                <ul>
                    <li>
                        <a class="sidebar-link @(ctrl=="Home" && action=="Privacy" ? "active" : "")"
                           asp-controller="Home" asp-action="Privacy">Privacidad</a>
                    </li>
                    <li>
                        <a class="sidebar-link @(ctrl=="Configuracion" ? "active" : "")"
                           asp-controller="Configuracion" asp-action="Index">Configuración</a>
                    </li>
                </ul>

            </nav>
        </aside>

        <!-- Overlay móvil -->
        <div class="sidebar-overlay" id="sidebarOverlay"></div>

        <!-- Contenido -->
        <div class="main-wrapper">
            <main class="main-content">
                @RenderBody()
            </main>

            <footer class="footer border-top text-muted">
                <div>
                    &copy; 2026 - ClaudetestMVC - <a asp-controller="Home" asp-action="Privacy">Privacidad</a>
                </div>
            </footer>
        </div>

    </div><!-- /app-body -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/apexcharts/apexcharts.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
